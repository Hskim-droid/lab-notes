---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<Base>
  <h1 style="font-size:1.5rem;margin:0 0 1rem">Notes</h1>
  {
    posts.length === 0 ? (
      <p class="meta">
        Learn-in-public lab notes. Two lanes: <strong>deep cut</strong> (labs, infra, papers, China ×
        SV) and <strong>scoreboard</strong> (new services + Gemini / Claude / ChatGPT / Grok).
      </p>
    ) : (
      posts.map((p) => (
        <article>
          <h1>
            <a href={`/posts/${p.id}/`}>{p.data.title}</a>
          </h1>
          <div class="meta">
            {p.data.pubDate.toISOString().slice(0, 10)}
            {p.data.tags?.length ? ` · ${p.data.tags.join(', ')}` : ''}
          </div>
          {p.data.description && <p style="margin:0.5rem 0 0">{p.data.description}</p>}
        </article>
      ))
    )
  }
</Base>
